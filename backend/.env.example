SIMULATION_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./visatrust.db
FRONTEND_ORIGIN=http://localhost:5173
SEED_DEMO_DATA=true

# Optional Claude assessment. Rules remain active if the API is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required when SIMULATION_MODE=false.
SEPOLIA_RPC_URL=
ESCROW_CONTRACT_ADDRESS=
ARBITRATOR_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=2
POLL_INTERVAL_SECONDS=3

# Fraud policy in six-decimal stablecoin base units (50 and 10 USDC by default).
HIGH_AMOUNT_UNITS=50000000
MEDIUM_AMOUNT_UNITS=10000000
STABLECOIN_SYMBOL=USDC
STABLECOIN_DECIMALS=6
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MEDIUM_COUNT=3
VELOCITY_HIGH_COUNT=5
RECALL_THRESHOLD=70
