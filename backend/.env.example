SIMULATION_MODE=true
# Set true with complete Sepolia settings to enable the UI's Testnet option
# while keeping simulation available. SIMULATION_MODE=false also enables it.
TESTNET_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./paradime.db
FRONTEND_ORIGIN=http://localhost:5173
SEED_DEMO_DATA=true

# Optional Claude assessment. Rules remain active if the API is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required when SIMULATION_MODE=false.
SEPOLIA_RPC_URL=
ESCROW_CONTRACT_ADDRESS=
# Circle-issued test USDC on Ethereum Sepolia (test tokens have no financial value).
PAYMENT_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ARBITRATOR_PRIVATE_KEY=
# Optional application-managed Sepolia payer for demos. Keep the key encrypted
# and explicitly enable the route only while running a controlled demo.
DEPLOYER_PRIVATE_KEY=
MANAGED_DEMO_WALLET_ENABLED=false
MANAGED_DEMO_MAX_AMOUNT_UNITS=50000000
MANAGED_DEMO_SESSION_BUDGET_UNITS=100000000
# Optional autonomous Sepolia buyer. This dedicated wallet must hold test USDC
# and Sepolia ETH; its spending is constrained by verified mandates in Paradime.
AUTONOMOUS_BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
CHAIN_CONFIRMATIONS=2
POLL_INTERVAL_SECONDS=3

# Fraud policy in six-decimal stablecoin base units (50 and 10 USDC by default).
HIGH_AMOUNT_UNITS=50000000
MEDIUM_AMOUNT_UNITS=10000000
STABLECOIN_SYMBOL=USDC
STABLECOIN_DECIMALS=6
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MEDIUM_COUNT=3
VELOCITY_HIGH_COUNT=5
RECALL_THRESHOLD=70

# Autonomous seller offer (one test USDC by default).
SELLER_SERVICE=text-analysis-v1
SELLER_PRICE_UNITS=1000000
AUTONOMOUS_PURCHASE_TIMEOUT_SECONDS=180
